# Bu dosyayı ".env" adıyla kopyalayın ve değerleri eşittir işaretinden sonra yazın.
# .env dosyası .gitignore içindedir; GitHub'a yüklenmez. İçindekileri kimseyle paylaşmayın.

# Ücretsiz anahtar: https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Sadece bir kez, bilgisayardaki veritabanını buluta taşırken (python -m app.cli tasi):
# Neon'daki bağlantı adresi (postgresql://...). Taşıma bitince bu satırı silebilirsiniz.
HEDEF_DB_URL=

# Boş bırakın. Doldurursanız bilgisayardaki site de bulut veritabanını kullanır.
DATABASE_URL=

# Boş bırakın. Doldurursanız bilgisayardaki site de şifre sorar.
SITE_PASSWORD=
